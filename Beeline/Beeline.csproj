<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Version>1.0.0.0</Version>
        <Description>Point at anything on your map and press one button: Beeline takes you there the quickest way. (Lifestream + vnavmesh)</Description>
        <Authors>KeydenK</Authors>
        <PackageProjectUrl>https://github.com/KeydenK/Beeline</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Shown in the plugin installer for dev builds, and shipped inside the release zip. -->
        <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" Link="images\icon.png" />
    </ItemGroup>
</Project>
