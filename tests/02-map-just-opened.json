{
  "name": "Beeline: the press that opens the map never starts a trip",
  "steps": [
    {
      "mark": "precondition: nothing targeted, not right next to an NPC or the aetheryte (Cross may also reach the game)"
    },
    {
      "cmd": "/beeline stop"
    },
    {
      "do": "map close"
    },
    {
      "waitFor": "!window:AreaMap",
      "timeout": 2000,
      "msg": "start with the map closed"
    },
    {
      "wait": 500
    },
    {
      "do": "map"
    },
    {
      "waitFor": "window:AreaMap",
      "timeout": 2000,
      "msg": "the map should open"
    },
    {
      "do": "focus AreaMap"
    },
    {
      "do": "pad Cross 80"
    },
    {
      "waitFor": "event:\\[Beeline\\] Button ignored: the map has just opened",
      "timeout": 2000,
      "msg": "a press within 0.5 s of opening the map must be ignored"
    },
    {
      "wait": 800
    },
    {
      "assert": "probe:Beeline:^trip=off",
      "msg": "no trip may start"
    },
    {
      "do": "map close"
    },
    {
      "waitFor": "!window:AreaMap",
      "timeout": 2000,
      "msg": "the map should close"
    },
    {
      "assert": "!event:\\[ERR\\] \\[Beeline\\]",
      "msg": "no errors from Beeline"
    }
  ]
}