{
  "name": "Beeline: a new destination mid-trip replaces the current trip",
  "steps": [
    {
      "assert": "zone:957 && near:185,610,45",
      "msg": "precondition: next to the Yedlihmad aetheryte in Thavnair"
    },
    {
      "cmd": "/beeline stop"
    },
    {
      "cmd": "/gaction \"Dismount\""
    },
    {
      "waitFor": "!mounted",
      "timeout": 10000,
      "msg": "on foot before the test (the previous trip may have ended on the mount, in the air)"
    },
    {
      "wait": 500
    },
    {
      "do": "flag 600 -300"
    },
    {
      "mark": "flag parked far away (a leftover flag near the test spots would catch the clicks: a map icon covers ~38 y at this zoom)"
    },
    {
      "do": "map"
    },
    {
      "waitFor": "window:AreaMap",
      "timeout": 2000,
      "msg": "the map should open"
    },
    {
      "wait": 800
    },
    {
      "do": "mapzoom 1.54"
    },
    {
      "wait": 3000
    },
    {
      "do": "mapclick 150 530 Left ctrl"
    },
    {
      "waitFor": "probe:Beeline:^trip=on",
      "timeout": 12000,
      "msg": "the trip should start"
    },
    {
      "waitFor": "probe:Beeline:phase=moving",
      "timeout": 15000,
      "msg": "the first trip should be under way"
    },
    {
      "wait": 1000
    },
    {
      "mark": "new destination: back to the start spot"
    },
    {
      "do": "mapclick 175 595 Left ctrl"
    },
    {
      "waitFor": "probe:Beeline:^trip=on; .*dest=957@\\((174|175|176),(594|595|596)\\)",
      "timeout": 12000,
      "msg": "the trip should now go to the new spot"
    },
    {
      "assert": "event:\\[Beeline\\] Trip replaced",
      "msg": "the first trip should end as replaced"
    },
    {
      "waitFor": "probe:Beeline:^trip=off",
      "timeout": 90000,
      "msg": "the new trip should end"
    },
    {
      "assert": "probe:Beeline:last=arrived",
      "msg": "it should arrive"
    },
    {
      "assert": "near:175,595,10",
      "msg": "you should be back to the start spot"
    },
    {
      "assert": "!anomaly:STUCK|SNAP",
      "msg": "no stuck or position snap (turning back is intended here, so WOBBLE is not checked)"
    },
    {
      "assert": "!event:\\[ERR\\] \\[Beeline\\]",
      "msg": "no errors from Beeline"
    }
  ]
}