{
  "name": "Beeline: map button with the cursor where you stand does nothing harmful",
  "steps": [
    {
      "mark": "precondition: nothing targeted, not right next to an NPC or the aetheryte; the map opens centred on you"
    },
    {
      "cmd": "/beeline stop"
    },
    {
      "cmd": "/gaction \"Dismount\""
    },
    {
      "waitFor": "!mounted",
      "timeout": 10000,
      "msg": "on foot before the test (the previous trip may have ended on the mount, in the air)"
    },
    {
      "wait": 500
    },
    {
      "do": "map close"
    },
    {
      "waitFor": "!window:AreaMap",
      "timeout": 2000,
      "msg": "start with the map closed"
    },
    {
      "wait": 500
    },
    {
      "do": "map"
    },
    {
      "waitFor": "window:AreaMap",
      "timeout": 2000,
      "msg": "the map should open"
    },
    {
      "wait": 1200
    },
    {
      "do": "focus AreaMap"
    },
    {
      "do": "pad Cross 80"
    },
    {
      "waitFor": "event:\\[Beeline\\] (Controller on map|Button ignored)",
      "timeout": 2000,
      "msg": "Beeline should see the press (on the map, or ignored because the map has no focus)"
    },
    {
      "waitFor": "probe:Beeline:^trip=off",
      "timeout": 20000,
      "msg": "a trip to where you already stand must end by itself"
    },
    {
      "cmd": "/beeline stop"
    },
    {
      "do": "map close"
    },
    {
      "waitFor": "!window:AreaMap",
      "timeout": 2000,
      "msg": "the map should close"
    },
    {
      "assert": "!anomaly:WOBBLE|STUCK|SNAP",
      "msg": "no wobble, stuck or position snap"
    },
    {
      "assert": "!event:\\[ERR\\] \\[Beeline\\]",
      "msg": "no errors from Beeline"
    }
  ]
}