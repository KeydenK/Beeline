{
  "name": "Beeline: moving yourself (left stick) cancels a trip",
  "steps": [
    { "assert": "zone:957 && near:196,628,30", "msg": "precondition: next to the Yedlihmad aetheryte in Thavnair" },
    { "cmd": "/beeline stop" },
    { "do": "flag 150 530" },
    { "cmd": "/beeline testflag" },
    { "waitFor": "probe:Beeline:phase=moving", "timeout": 15000, "msg": "the trip should be under way" },
    { "wait": 2000 },
    { "do": "stick L 0 1 800" },
    { "waitFor": "probe:Beeline:^trip=off; .*last=cancelled-you-moved", "timeout": 3000, "msg": "pushing the stick should cancel the trip" },
    { "assert": "event:\\[Beeline\\] You moved: trip cancelled", "msg": "the log should give the reason" },
    { "wait": 1500 },
    { "mark": "back to the aetheryte" },
    { "do": "flag 190 615" },
    { "cmd": "/beeline testflag" },
    { "waitFor": "probe:Beeline:^trip=on", "timeout": 3000, "msg": "the return trip should start" },
    { "waitFor": "probe:Beeline:^trip=off", "timeout": 90000, "msg": "the return trip should end" },
    { "assert": "probe:Beeline:last=arrived", "msg": "the return trip should arrive" },
    { "assert": "near:190,615,10", "msg": "you should be back at the aetheryte" },
    { "assert": "!anomaly:STUCK|SNAP", "msg": "no stuck or position snap (a turn when you take over is expected, so WOBBLE is not checked)" },
    { "assert": "!event:\\[ERR\\] \\[Beeline\\]", "msg": "no errors from Beeline" }
  ]
}
