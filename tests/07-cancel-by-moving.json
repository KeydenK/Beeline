{
  "name": "Beeline: moving yourself (left stick) cancels a trip",
  "steps": [
    {
      "assert": "zone:957 && near:150,530,25",
      "msg": "precondition: next to the Yedlihmad aetheryte in Thavnair"
    },
    {
      "cmd": "/beeline stop"
    },
    {
      "do": "dismount"
    },
    {
      "waitFor": "event:dismount (done|FAILED)",
      "timeout": 45000,
      "msg": "on foot before the test (lands first if needed)"
    },
    {
      "assert": "!cond:Mounted",
      "msg": "on foot"
    },
    {
      "do": "flag 600 -300"
    },
    {
      "mark": "flag parked far away (a leftover flag near the test spots would catch the clicks: a map icon covers ~38 y at this zoom)"
    },
    {
      "do": "map close"
    },
    {
      "waitFor": "!window:AreaMap",
      "timeout": 2000
    },
    {
      "wait": 500
    },
    {
      "do": "map"
    },
    {
      "waitFor": "window:AreaMap",
      "timeout": 2000,
      "msg": "the map should open"
    },
    {
      "wait": 800
    },
    {
      "do": "mapzoom 1.54"
    },
    {
      "wait": 3000
    },
    {
      "do": "mapclick 330 470 Left ctrl"
    },
    {
      "waitFor": "probe:Beeline:^trip=on",
      "timeout": 12000,
      "msg": "the trip should start"
    },
    {
      "waitFor": "probe:Beeline:phase=moving",
      "timeout": 15000,
      "msg": "the trip should be under way"
    },
    {
      "wait": 2000
    },
    {
      "do": "stick L 0 1 800"
    },
    {
      "waitFor": "probe:Beeline:^trip=off; .*last=cancelled-you-moved",
      "timeout": 3000,
      "msg": "pushing the stick should cancel the trip"
    },
    {
      "assert": "event:\\[Beeline\\] You moved: trip cancelled",
      "msg": "the log should give the reason"
    },
    {
      "wait": 1500
    },
    {
      "mark": "back to the start spot"
    },
    {
      "do": "map close"
    },
    {
      "waitFor": "!window:AreaMap",
      "timeout": 2000
    },
    {
      "wait": 500
    },
    {
      "do": "map"
    },
    {
      "waitFor": "window:AreaMap",
      "timeout": 2000,
      "msg": "the map should open"
    },
    {
      "wait": 800
    },
    {
      "do": "mapzoom 1.54"
    },
    {
      "wait": 3000
    },
    {
      "do": "mapclick 150 530 Left ctrl"
    },
    {
      "waitFor": "probe:Beeline:^trip=on",
      "timeout": 12000,
      "msg": "the return trip should start"
    },
    {
      "waitFor": "probe:Beeline:^trip=off",
      "timeout": 90000,
      "msg": "the return trip should end"
    },
    {
      "assert": "probe:Beeline:last=arrived",
      "msg": "the return trip should arrive"
    },
    {
      "assert": "near:150,530,14",
      "msg": "you should be back to the start spot"
    },
    {
      "assert": "!anomaly:STUCK|SNAP",
      "msg": "no stuck or position snap (a turn when you take over is expected, so WOBBLE is not checked)"
    },
    {
      "assert": "!event:\\[ERR\\] \\[Beeline\\]",
      "msg": "no errors from Beeline"
    }
  ]
}